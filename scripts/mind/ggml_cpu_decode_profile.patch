diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index a76af84..1afb20a 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3107,6 +3107,52 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }

+
+struct kiwi_cpu_profile {
+    int64_t total;
+    int64_t op[GGML_OP_COUNT];
+    int64_t dense[GGML_TYPE_COUNT];
+    int64_t expert[GGML_TYPE_COUNT];
+    int64_t large_projection;
+    int64_t projection_rows;
+    bool single_token_moe;
+};
+
+static void kiwi_cpu_profile_record(struct kiwi_cpu_profile * profile, const struct ggml_tensor * node, int64_t elapsed) {
+    profile->total += elapsed;
+    profile->op[node->op] += elapsed;
+    if (node->op == GGML_OP_MUL_MAT_ID) {
+        profile->expert[node->src[0]->type] += elapsed;
+        profile->single_token_moe |= node->src[2]->ne[1] == 1;
+    }
+    if (node->op == GGML_OP_MUL_MAT) {
+        profile->dense[node->src[0]->type] += elapsed;
+        if (node->src[0]->ne[1] >= 32768) {
+            profile->large_projection += elapsed;
+            profile->projection_rows = node->src[0]->ne[1];
+        }
+    }
+}
+
+static void kiwi_cpu_profile_print(const struct kiwi_cpu_profile * profile) {
+    fprintf(stderr, "KIWI_CPU_DECODE total=%" PRId64 " large_projection=%" PRId64 " projection_rows=%" PRId64,
+            profile->total, profile->large_projection, profile->projection_rows);
+    for (int op = 0; op < GGML_OP_COUNT; op++) {
+        if (profile->op[op]) {
+            fprintf(stderr, " %s=%" PRId64, ggml_op_name(op), profile->op[op]);
+        }
+    }
+    for (int type = 0; type < GGML_TYPE_COUNT; type++) {
+        if (profile->dense[type]) {
+            fprintf(stderr, " dense_%s=%" PRId64, ggml_type_name(type), profile->dense[type]);
+        }
+        if (profile->expert[type]) {
+            fprintf(stderr, " moe_%s=%" PRId64, ggml_type_name(type), profile->expert[type]);
+        }
+    }
+    fputc('\n', stderr);
+}
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3135,6 +3181,11 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif

+    const bool profile_enabled = state->ith == 0 && getenv("GGML_KIWI_CPU_PROFILE") != NULL;
+    struct kiwi_cpu_profile profile = { 0 };
+    const struct ggml_tensor * final_node = NULL;
+    int64_t final_start = 0;
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];

@@ -3147,6 +3198,7 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }

+        const int64_t start = profile_enabled ? ggml_time_us() : 0;
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3164,6 +3216,12 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {

         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
+            if (profile_enabled) {
+                kiwi_cpu_profile_record(&profile, node, ggml_time_us() - start);
+            }
+        } else if (profile_enabled) {
+            final_node = node;
+            final_start = start;
         }
     }

@@ -3175,6 +3233,13 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {

     ggml_barrier(state->threadpool);

+    if (final_node != NULL) {
+        kiwi_cpu_profile_record(&profile, final_node, ggml_time_us() - final_start);
+    }
+    if (profile.single_token_moe) {
+        kiwi_cpu_profile_print(&profile);
+    }
+
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
 #endif
